{


  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "declarationDir": "dist/.tsbuild/web",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/web/*"],
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
