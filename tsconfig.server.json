{


  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "emitDeclarationOnly": true,
    "declarationDir": "dist/.tsbuild/server",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/server/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
